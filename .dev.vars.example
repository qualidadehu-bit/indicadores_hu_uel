# Copie para .dev.vars na RAIZ do projeto (ao lado de wrangler.toml). Não commitar.
# Usado por `npm run cf:dev` / `wrangler dev`
# Se você tinha worker/.dev.vars, mova o arquivo para a raiz e renomeie para .dev.vars
GAS_SECRET="cole-o-mesmo-valor-de-API_SECRET-do-Google"
GAS_WEBAPP_URL=https://script.google.com/macros/s/SEU_DEPLOY/exec
