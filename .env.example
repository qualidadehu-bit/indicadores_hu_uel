# Frontend (Vite) — copie para `.env` ou `.env.local`
# URL do Worker (padrão no código: http://127.0.0.1:8787 se omitir)
VITE_WORKER_URL=http://127.0.0.1:8787

# Opcional — debug local: envia cabeçalho X-GAS-Secret (igual API_SECRET no GAS).
# Fica no bundle do navegador; não use em produção com segredo real.
# VITE_GAS_SECRET=

# Worker (Wrangler) — veja .dev.vars.example na raiz e gas/Code.gs (API_SECRET / GAS_WEBAPP_URL / GAS_SECRET)
